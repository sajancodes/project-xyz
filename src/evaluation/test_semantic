while True:

    user_text = input("You: ").strip()

    if user_text.lower() == "exit":
        break

    if not user_text:
        continue

    prompt = (
        "User: "
        + user_text
        + "\nAssistant:"
    )

    result = generate(
        prompt,
        max_new_tokens=80,
        temperature=0.5
    )

    # Only display the generated continuation
    if "Assistant:" in result:

        answer = result.split(
            "Assistant:",
            1
        )[1]

    else:

        answer = result

    print()
    print("Model:", answer.strip())
    print()