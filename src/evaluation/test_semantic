import torch
from tokenizers import Tokenizer

from model import SmallEnglishLLM
from model_config import ModelConfig


CHECKPOINT = "checkpoint-semantic-5000.pt"
TOKENIZER_PATH = "tokenizer.json"

DEVICE = torch.device("cuda" if torch.cuda.is_available() else "cpu")

config = ModelConfig()

tokenizer = Tokenizer.from_file(TOKENIZER_PATH)

model = SmallEnglishLLM(config).to(DEVICE)

checkpoint = torch.load(
    CHECKPOINT,
    map_location=DEVICE
)

model.load_state_dict(checkpoint["model_state_dict"])
model.eval()

print("=" * 70)
print("SEMANTIC MODEL TEST")
print("=" * 70)
print("Checkpoint:", CHECKPOINT)
print("Training step:", checkpoint.get("step"))
print("Device:", DEVICE)
print("=" * 70)


def generate(prompt, max_new_tokens=80, temperature=0.7):

    encoded = tokenizer.encode(prompt)

    input_ids = torch.tensor(
        [encoded.ids],
        dtype=torch.long,
        device=DEVICE
    )

    with torch.no_grad():

        for _ in range(max_new_tokens):

            # Keep context within model limit
            input_context = input_ids[:, -config.max_seq_len:]

            logits, _ = model(input_context)

            next_logits = logits[:, -1, :]

            # Temperature
            next_logits = next_logits / temperature

            probabilities = torch.softmax(
                next_logits,
                dim=-1
            )

            next_token = torch.multinomial(
                probabilities,
                num_samples=1
            )

            input_ids = torch.cat(
                [input_ids, next_token],
                dim=1
            )

            # Stop if tokenizer has an EOS token
            if tokenizer.token_to_id("</s>") is not None:
                if next_token.item() == tokenizer.token_to_id("</s>"):
                    break

    output = tokenizer.decode(
        input_ids[0].tolist()
    )

    return output


